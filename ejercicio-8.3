class VentanaPrincipal(tk.Tk):
    """Clase que define la ventana principal del menú de figuras."""
    def __init__(self):
        super().__init__()
        self._ventanas = {}
        self.inicio()
        self.title("Figuras")
        self.geometry("450x120")
        self.resizable(False, False)
        self.eval('tk::PlaceWindow . center')

    def inicio(self):
        self.cilindro = tk.Button(self, text="Cilindro", command=self.abrir_cilindro)
        self.cilindro.place(x=20, y=45, width=75, height=25)

        self.esfera = tk.Button(self, text="Esfera", command=self.abrir_esfera)
        self.esfera.place(x=105, y=45, width=75, height=25)

        self.piramide = tk.Button(self, text="Pirámide", command=self.abrir_piramide)
        self.piramide.place(x=190, y=45, width=80, height=25)

        self.cubo = tk.Button(self, text="Cubo", command=self.abrir_cubo)
        self.cubo.place(x=280, y=45, width=70, height=25)

        self.prisma = tk.Button(self, text="Prisma", command=self.abrir_prisma)
        self.prisma.place(x=360, y=45, width=70, height=25)

    def _mostrar_unica(self, clave, clase_ventana):
        ventana = self._ventanas.get(clave)
        if ventana is None or not ventana.winfo_exists():
            self._ventanas[clave] = clase_ventana(self)
        else:
            ventana.lift()
            ventana.focus_force()

    def abrir_cilindro(self):
        self._mostrar_unica("cilindro", VentanaCilindro)

    def abrir_esfera(self):
        self._mostrar_unica("esfera", VentanaEsfera)

    def abrir_piramide(self):
        self._mostrar_unica("piramide", VentanaPiramide)

    def abrir_cubo(self):
        self._mostrar_unica("cubo", VentanaCubo)

    def abrir_prisma(self):
        self._mostrar_unica("prisma", VentanaPrisma)


class Principal:
    """Clase de punto de ingreso al programa."""
    @staticmethod
    def main():
        miVentanaPrincipal = VentanaPrincipal()
        miVentanaPrincipal.mainloop()


if __name__ == "__main__":
    Principal.main()
