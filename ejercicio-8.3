import tkinter as tk
from tkinter import messagebox
import math
import os


class FiguraGeometrica:
    """Clase base que modela una figura geométrica."""
    def __init__(self):
        self._volumen = 0.0
        self._superficie = 0.0

    def set_volumen(self, volumen):
        self._volumen = volumen

    def set_superficie(self, superficie):
        self._superficie = superficie

    def get_volumen(self):
        return self._volumen

    def get_superficie(self):
        return self._superficie


class Cilindro(FiguraGeometrica):
    """Subclase de FiguraGeometrica que cuenta con radio y altura."""
    def __init__(self, radio, altura):
        super().__init__()
        self.radio = radio
        self.altura = altura
        self.set_volumen(self.calcular_volumen())
        self.set_superficie(self.calcular_superficie())

    def calcular_volumen(self):
        return math.pi * self.altura * math.pow(self.radio, 2.0)

    def calcular_superficie(self):
        area_lado_a = 2.0 * math.pi * self.radio * self.altura
        area_lado_b = 2.0 * math.pi * math.pow(self.radio, 2.0)
        return area_lado_a + area_lado_b


class Esfera(FiguraGeometrica):
    """Subclase de FiguraGeometrica que cuenta con un radio."""
    def __init__(self, radio):
        super().__init__()
        self.radio = radio
        self.set_volumen(self.calcular_volumen())
        self.set_superficie(self.calcular_superficie())

    def calcular_volumen(self):
        return (4.0 / 3.0) * math.pi * math.pow(self.radio, 3.0)

    def calcular_superficie(self):
        return 4.0 * math.pi * math.pow(self.radio, 2.0)


class Piramide(FiguraGeometrica):
    """Subclase de FiguraGeometrica con base, altura y apotema."""
    def __init__(self, base, altura, apotema):
        super().__init__()
        self.base = base
        self.altura = altura
        self.apotema = apotema
        self.set_volumen(self.calcular_volumen())
        self.set_superficie(self.calcular_superficie())

    def calcular_volumen(self):
        return (math.pow(self.base, 2.0) * self.altura) / 3.0

    def calcular_superficie(self):
        area_base = math.pow(self.base, 2.0)
        area_lado = 2.0 * self.base * self.apotema
        return area_base + area_lado


class Cubo(FiguraGeometrica):
    """Subclase de FiguraGeometrica que calcula el volumen y superficie de un cubo."""
    def __init__(self, lado):
        super().__init__()
        self.lado = lado
        self.set_volumen(self.calcular_volumen())
        self.set_superficie(self.calcular_superficie())

    def calcular_volumen(self):
        return math.pow(self.lado, 3.0)

    def calcular_superficie(self):
        return 6.0 * math.pow(self.lado, 2.0)


class Prisma(FiguraGeometrica):
    """Subclase de FiguraGeometrica que calcula el volumen y superficie de un prisma rectangular."""
    def __init__(self, largo, ancho, altura):
        super().__init__()
        self.largo = largo
        self.ancho = ancho
        self.altura = altura
        self.set_volumen(self.calcular_volumen())
        self.set_superficie(self.calcular_superficie())

    def calcular_volumen(self):
        return self.largo * self.ancho * self.altura

    def calcular_superficie(self):
        return 2.0 * ((self.largo * self.ancho) + (self.largo * self.altura) + (self.ancho * self.altura))


class VentanaFigura(tk.Toplevel):
    """Clase base para las ventanas de figuras con soporte de imagen y centrado."""
    def configurar_ventana(self, titulo, ancho, alto):
        self.title(titulo)
        x = (self.winfo_screenwidth() // 2) - (ancho // 2)
        y = (self.winfo_screenheight() // 2) - (alto // 2)
        self.geometry(f"{ancho}x{alto}+{x}+{y}")
        self.resizable(False, False)

    def cargar_imagen(self, archivo_imagen):
        try:
            directorio = os.path.dirname(os.path.abspath(__file__))
            ruta = os.path.join(directorio, archivo_imagen)
            self.img = tk.PhotoImage(file=ruta)
            self.lbl_img = tk.Label(self, image=self.img)
            self.lbl_img.place(x=210, y=20, width=120, height=120)
        except Exception:
            self.lbl_img = tk.Label(
                self, text="[Sin Imagen]", fg="red", borderwidth=1, relief="solid"
            )
            self.lbl_img.place(x=210, y=20, width=120, height=120)

    @staticmethod
    def leer_float(campo):
        valor = float(campo.get().strip())
        if not math.isfinite(valor):
            raise ValueError
        return valor


class VentanaCilindro(VentanaFigura):
    def __init__(self, master=None):
        super().__init__(master)
        self.inicio()
        self.configurar_ventana("Cilindro", 350, 210)

    def inicio(self):
        self.radio = tk.Label(self, text="Radio (cms):", anchor="w")
        self.radio.place(x=20, y=20, width=80, height=23)
        self.campoRadio = tk.Entry(self)
        self.campoRadio.place(x=100, y=20, width=90, height=23)

        self.altura = tk.Label(self, text="Altura (cms):", anchor="w")
        self.altura.place(x=20, y=50, width=80, height=23)
        self.campoAltura = tk.Entry(self)
        self.campoAltura.place(x=100, y=50, width=90, height=23)

        self.calcular = tk.Button(self, text="Calcular", command=self.actionPerformed)
        self.calcular.place(x=100, y=80, width=90, height=23)

        self.volumen = tk.Label(self, text="Volumen (cm3):", anchor="w")
        self.volumen.place(x=20, y=110, width=185, height=23)

        self.superficie = tk.Label(self, text="Superficie (cm2):", anchor="w")
        self.superficie.place(x=20, y=140, width=185, height=23)

        self.cargar_imagen("cilindro.png")

    def actionPerformed(self):
        try:
            radio = self.leer_float(self.campoRadio)
            altura = self.leer_float(self.campoAltura)
            cilindro = Cilindro(radio, altura)

            self.volumen.config(text=f"Volumen (cm3): {cilindro.calcular_volumen():.2f}")
            self.superficie.config(text=f"Superficie (cm2): {cilindro.calcular_superficie():.2f}")
        except Exception:
            messagebox.showerror("Error", "Campo nulo o error en formato de número", parent=self)


